u v\'c9n ch\'ada th\'e8ng nh\'cat th\'d7 Quy\'d5t \'ae\'denh c\'f1a B\'e9 T\'b5i ch\'ddnh l\'b5 quy\'d5t \'ae\'denh cu\'e8i c\'efng. K\'d5t qu\'b6 truy thu v\'b5 ph\'b9t \'ae\'ad\'eec t\'ddnh v\'b5o k\'d5t qu\'b6 thu \'eb \'ae\'dea ph\'ad\'acng n\'aci th
\'f9c hi\'d6n truy thu.
\par 3/ Tr\'ad\'eang h\'eep do c\'b8c c\'ac quan kh\'b8c ki\'d3m tra ph\'b8t hi\'d6n th\'d7 t\'e6ng h\'eep h\'e5 s\'ac \'ae\'d2 ngh\'de c\'ac quan H\'b6i quan ra quy\'d5t \'ae\'denh truy thu, ph\'b9t v\'b5 t\'e6 ch\'f8c thu theo quy \'ae\'denh.
\par 4/ C\'b8c \'ae\'acn v\'de, c\'b8 nh\'a9n c\'e3 c\'abng trong vi\'d6c ki\'d3m tra, ph\'b8t hi\'d6n truy thu thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u v\'b5 ph\'b9t \'ae\'ad\'eec tr\'ddch th\'ad\'ebng theo ch\'d5 \'ae\'e9 quy \'ae\'denh.
\par  
\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28 h - khi\'d5u n\'b9i v\'b5 th\'eai hi\'d6u thi h\'b5nh
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 I/ Quy\'d2n v\'b5 tr\'b8ch nhi\'d6m c\'f1a \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 \line trong vi\'d6c khi\'d5u n\'b9i v\'d2 thu\'d5:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par Theo quy \'ae\'denh t\'b9i \'a7i\'d2u 19 Ngh\'de \'ae\'denh s\'e8 54/CP ng\'b5y 28/08/1993, \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 c\'e3 quy\'d2n khi\'d5u n\'b9i l\'aan T\'e6ng c\'f4c H\'b6i quan v\'d2 vi\'d6c c\'b8n b\'e9 H\'b6i quan, C\'ac quan H\'b6
i quan v\'b5 c\'b8n b\'e9, c\'ac quan c\'e3 th\'c8m quy\'d2n kh\'b8c trong vi\'d6c x\'f6 l\'fd vi ph\'b9m quy \'ae\'denh t\'b9i \'aei\'d3m 1, \'aei\'d3m 3, \'a7i\'d2u 20 Lu\'cbt thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u ng\'b5y 26/12/1991 \'ae\'b7 
\'ae\'ad\'eec s\'f6a \'ae\'e6i, b\'e6 sung t\'b9i \'aei\'d3m 5, \'a7i\'d2u 1 Lu\'cbt s\'e8 04/1998/QH10 ng\'b5y 20/05/1998. Trong th\'eai h\'b9n 20 ng\'b5y k\'d3 t\'f5 ng\'b5y nh\'cbn \'ae\'ad\'eec \'ae\'acn khi\'d5u n\'b9i, T\'e6ng c\'f4c H\'b6i quan c
\'e3 tr\'b8ch nhi\'d6m gi\'b6i quy\'d5t xong \'ae\'acn khi\'d5u n\'b9i c\'f1a \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5. Trong khi ch\'ea gi\'b6i quy\'d5t t\'e6 ch\'f8c, c\'b8 nh\'a9n khi\'d5u n\'b9i v\'c9n ph\'b6i n\'e9p \'ae\'f1 v\'b5 \'ae\'f3ng th\'eai h
\'b9n v\'d2 s\'e8 ti\'d2n thu\'d5, ti\'d2n ph\'b9t theo th\'abng b\'b8o ho\'c6c Quy\'d5t \'ae\'denh x\'f6 l\'fd.
\par N\'d5u t\'e6 ch\'f8c, c\'b8 nh\'a9n khi\'d5u n\'b9i kh\'abng \'ae\'e5ng \'fd v\'edi quy\'d5t \'ae\'denh c\'f1a T\'e6ng c\'f4c H\'b6i quan, ho\'c6c qu\'b8 th\'eai h\'b9n gi\'b6i quy\'d5t theo quy \'ae\'denh m\'b5 ch\'ada nh\'cbn \'ae\'ad\'eec \'fd ki\'d5
n gi\'b6i quy\'d5t c\'f1a T\'e6ng c\'f4c H\'b6i quan th\'d7 t\'e6 ch\'f8c, c\'b8 nh\'a9n c\'e3 quy\'d2n khi\'d5u n\'b9i l\'aan B\'e9 tr\'ad\'ebng B\'e9 T\'b5i ch\'ddnh ho\'c6c kh\'ebi ki\'d6n ra T\'dfa \'b8n theo quy \'ae\'denh c\'f1a Ph\'b8p lu\'cbt. Tr
\'ad\'eang h\'eep t\'e6 ch\'f8c, c\'b8 nh\'a9n kh\'abng kh\'ebi ki\'d6n \'ae\'d5n t\'dfa \'b8n, m\'b5 khi\'d5u n\'b9i l\'aan B\'e9 tr\'ad\'ebng B\'e9 T\'b5i ch\'ddnh th\'d7 Quy\'d5t \'ae\'denh c\'f1a B\'e9 tr\'ad\'ebng B\'e9 T\'b5i ch\'ddnh l\'b5 quy\'d5
t \'ae\'denh cu\'e8i c\'efng.
\par Th\'f1 t\'f4c, tr\'d7nh t\'f9 khi\'d5u n\'b9i hay kh\'ebi ki\'d6n v\'b5 vi\'d6c xem x\'d0t, gi\'b6i quy\'d5t th\'f9c hi\'d6n \'ae\'f3ng theo c\'b8c quy \'ae\'denh Ph\'b8p lu\'cbt hi\'d6n h\'b5nh.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 II/ Tr\'b8ch nhi\'d6m v\'b5 quy\'d2n h\'b9n c\'f1a c\'b8c c\'ac quan trong \line vi\'d6c gi\'b6i quy\'d5t khi\'d5u n\'b9i:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par C\'b8c c\'ac quan c\'e3 tr\'b8ch nhi\'d6m gi\'b6i quy\'d5t khi\'d5u n\'b9i c\'f1a \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 \'ae\'f3ng th\'eai h\'b9n quy \'ae\'denh t\'b5i \'a7i\'d2u 19 Ngh\'de \'ae\'denh 54/CP ng\'b5y 28/08/1993 c\'f1a Ch\'ddnh ph\'f1. N\'d5
u v\'f4 vi\'d6c kh\'abng thu\'e9c th\'c8m quy\'d2n gi\'b6i quy\'d5t c\'f1a m\'d7nh th\'d7 ph\'b6i chuy\'d3n h\'e5 s\'ac ho\'c6c b\'b8o c\'b8o c\'ac quan c\'e3 th\'c8m quy\'d2n gi\'b6i quy\'d5t \'ae\'d3 gi\'b6i quy\'d5t theo quy \'ae\'denh.
\par C\'b8c c\'ac quan gi\'b6i quy\'d5t khi\'d5u n\'b9i c\'e3 quy\'d2n y\'aau c\'c7u t\'e6 ch\'f8c, c\'b8 nh\'a9n khi\'d5u n\'b9i cung c\'cap c\'b8c h\'e5 s\'ac, t\'b5i li\'d6u c\'e3 li\'aan quan \'ae\'d5n vi\'d6c khi\'d5u n\'b9i. N\'d5u t\'e6 ch\'f8c, c\'b8
 nh\'a9n t\'f5 ch\'e8i cung c\'cap h\'e5 s\'ac, t\'b5i li\'d6u th\'d7 c\'ac quan gi\'b6i quy\'d5t khi\'d5u n\'b9i c\'e3 quy\'d2n t\'f5 ch\'e8i xem x\'d0t gi\'b6i quy\'d5t khi\'d5u n\'b9i v\'b5 th\'abng b\'b8o cho t\'e6 ch\'f8c, c\'b8 nh\'a9n khi\'d5u n
\'b9i bi\'d5t.
\par  
\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28 I- Ch\'d5 \'ae\'e9 thu n\'e9p thu\'d5 v\'b5 ch\'d5 \'ae\'e9 b\'b8o c\'b8o
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 I/ Ch\'d5 \'ae\'e9 thu n\'e9p thu\'d5:}{
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par Thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u, ti\'d2n ph\'b9t \'ae\'ad\'eec n\'e9p v\'b5o Ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc theo ch\'ad\'acng, lo\'b9i, kho\'b6n, h\'b9ng, m\'f4c th\'ddch h\'eep c\'f1a m\'f4c l\'f4c Ng\'a9n s\'b8ch Nh\'b5 n\'ad\'ed
c, theo \'ae\'f3ng quy \'ae\'denh c\'f1a Lu\'cbt Ng\'a9n s\'b8ch Nh\'b5 n\'ad\'edc. Ri\'aang ti\'d2n thu\'d5 thu \'ae\'e8i v\'edi h\'b5ng l\'b5 v\'cbt t\'ad, nguy\'aan li\'d6u nh\'cbp kh\'c8u \'ae\'d3 s\'b6n xu\'cat h\'b5ng xu\'cat kh\'c8u; h\'b5ng t\'b9
m nh\'cbp \'ae\'d3 t\'b8i xu\'cat, h\'b5ng t\'b9m xu\'cat \'ae\'d3 t\'b8i nh\'cbp; m\'b8y m\'e3c, thi\'d5t b\'de, d\'f4ng c\'f4, ph\'ad\'acng ti\'d6n nh\'cbp kh\'c8u \'ae\'d3 ph\'f4c v\'f4 thi c\'abng, s\'b6n xu\'cat theo ph\'ad\'acng th\'f8c t\'b9m nh
\'cbp, t\'b8i xu\'cat \'ae\'ad\'eec n\'e9p v\'b5o t\'b5i kho\'b6n ti\'d2n g\'f6i ri\'aang t\'b9i Kho b\'b9c Nh\'b5 n\'ad\'edc. C\'ac quan H\'b6i quan ch\'d8 \'ae\'ad\'eec d\'efng ti\'d2n g\'f6i \'eb t\'b5i kho\'b6n n\'b5y \'ae\'d3 ho\'b5n thu\'d5 \'ae\'e8
i v\'edi c\'b8c tr\'ad\'eang h\'eep \'ae\'ad\'eec ho\'b5n thu\'d5 quy \'ae\'denh t\'b9i \'aei\'d3m 1g, 1h, 1i v\'b5 1m c\'f1a \'aei\'d3m 1 M\'f4c I, Ph\'c7n E Th\'abng t\'ad n\'b5y.
\par 
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 II/ Ch\'d5 \'ae\'e9 b\'b8o c\'b8o:}{
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par 1/ B\'b8o c\'b8o thu n\'e9p thu\'d5, n\'ee \'ae\'e4ng, ho\'b5n thu\'d5:
\par a/ B\'b8o c\'b8o thu n\'e9p thu\'d5:
\par H\'b5ng th\'b8ng, T\'e6ng c\'f4c H\'b6i quan l\'cbp b\'b8o c\'b8o k\'d5t qu\'b6 thu n\'e9p thu\'d5 g\'f6i B\'e9 T\'b5i ch\'ddnh g\'e5m b\'b8o c\'b8o nhanh 15 ng\'b5y theo m\'c9u s\'e8 01-BCN (\'ae\'ddnh k\'ccm) v\'b5 ch\'cbm nh\'cat l\'b5 ng\'b5y 10 c\'f1
a th\'b8ng sau ph\'b6i b\'b8o c\'b8o s\'e8 thu thu\'d5 ch\'ddnh th\'f8c c\'f1a th\'b8ng tr\'ad\'edc theo m\'c9u s\'e8 02-BCT (\'ae\'ddnh k\'ccm).
\par b/ B\'b8o c\'b8o n\'ee \'ae\'e4ng thu\'d5:
\par H\'b5ng th\'b8ng, ch\'cbm nh\'cat \'ae\'d5n ng\'b5y 10 c\'f1a th\'b8ng sau T\'e6ng c\'f4c H\'b6i quan ph\'b6i b\'b8o c\'b8o s\'e8 n\'ee thu\'d5 \'ae\'d5n cu\'e8i th\'b8ng cho B\'e9 T\'b5i ch\'ddnh theo m\'c9u s\'e8 03-BC\'a7 (\'ae\'ddnh k\'ccm).
\par c/ B\'b8o c\'b8o s\'e8 thu\'d5 t\'b9m thu, ho\'b5n thu\'d5 t\'f5 t\'b5i kho\'b6n t\'b9m thu:
\par H\'b5ng th\'b8ng, ch\'cbm nh\'cat \'ae\'d5n ng\'b5y 10 c\'f1a th\'b8ng sau, T\'e6ng c\'f4c H\'b6i quan ph\'b6i b\'b8o c\'b8o cho B\'e9 T\'b5i ch\'ddnh s\'e8 thu\'d5 t\'b9m thu, s\'e8 thu\'d5 \'ae\'b7 ho\'b5n c\'f1a th\'b8ng tr\'ad\'edc theo m\'c9u s\'e8
 04-BCTT (\'ae\'ddnh k\'ccm).
\par 2. B\'b8o c\'b8o h\'b5ng mi\'d4n thu\'d5; h\'b5ng kh\'abng thu\'e9c di\'d6n ch\'deu thu\'d5:
\par H\'b5ng qu\'dd, ch\'cbm nh\'cat \'ae\'d5n ng\'b5y 20 c\'f1a th\'b8ng \'ae\'c7u qu\'dd sau, T\'e6ng c\'f4c H\'b6i quan ph\'b6i b\'b8o c\'b8o cho B\'e9 T\'b5i ch\'ddnh s\'e8 thu\'d5 \'ae\'b7 gi\'b6i quy\'d5t mi\'d4n, x\'d0t s\'e8 h\'b5ng \'ae\'b7 l\'b5m th
\'f1 t\'f4c H\'b6i quan thu\'e9c di\'d6n kh\'abng ch\'deu thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u c\'f1a qu\'dd theo m\'c9u s\'e8 05-BCMT (\'ae\'ddnh k\'ccm).
\par 
\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28 k - t\'e6 ch\'f8c th\'f9c hi\'d6n
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par Th\'abng t\'ad n\'b5y c\'e3 hi\'d6u l\'f9c thi h\'b5nh t\'f5 ng\'b5y 01/01/1999. B\'b7i b\'e1 c\'b8c Th\'abng t\'ad s\'e8 72A TC/TCT ng\'b5y 30/08/1993; s\'e8 53 TC/TCT ng\'b5y 13/07/1995; s\'e8 84/1997/TT/BTC ng\'b5y 13/11/1997; s\'e8 106/1998/TT/BTC ng
\'b5y 23/07/1998 c\'f1a B\'e9 T\'b5i ch\'ddnh v\'b5 nh\'f7ng h\'ad\'edng d\'c9n v\'d2 thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u trong c\'b8c v\'a8n b\'b6n tr\'ad\'edc \'ae\'a9y tr\'b8i v\'edi Th\'abng t\'ad n\'b5y \'ae\'d2u b\'de b\'b7i b\'e1.

\par B\'e9 T\'b5i ch\'ddnh giao cho T\'e6ng c\'f4c Thu\'d5 theo d\'e2i, ki\'d3m tra vi\'d6c thu, n\'e9p thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u c\'f1a Ng\'b5nh H\'b6i quan theo \'ae\'f3ng quy \'ae\'denh t\'b9i \'a7i\'d2u 23 Ngh\'de \'ae\'denh s\'e8
 54/CP ng\'b5y 28/08/1993 c\'f1a Ch\'ddnh ph\'f1 v\'b5 Th\'abng t\'ad n\'b5y.
\par T\'e6ng c\'f4c H\'b6i quan t\'e6 ch\'f8c th\'f9c hi\'d6n Lu\'cbt thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u trong Ng\'b5nh H\'b6i quan v\'b5 ki\'d3m tra vi\'d6c th\'f9c hi\'d6n theo quy \'ae\'denh c\'f1a Th\'abng t\'ad n\'b5y.
\par Trong qu\'b8 tr\'d7nh th\'f9c hi\'d6n, n\'d5u c\'e3 kh\'e3 kh\'a8n v\'ad\'edng m\'bec, \'ae\'d2 ngh\'de c\'b8c \'ae\'acn v\'de, c\'ac quan ph\'b6n \'b8nh k\'dep th\'eai v\'d2 B\'e9 T\'b5i ch\'ddnh \'ae\'d3 nghi\'aan c\'f8u, h\'ad\'edng d\'c9n, b\'e6 sung.

\par   
