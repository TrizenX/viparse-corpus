\par C\'ac quan H\'b6i quan c\'a8n c\'f8 v\'b5o \'aei\'d2u ki\'d6n, quy \'ae\'denh n\'aau tr\'aan \'ae\'d3 t\'ddnh v\'b5 thu thu\'d5 nh\'cbp kh\'c8u cho t\'f5ng tr\'ad\'eang h\'eep \'ae\'f3ng v\'edi thu\'d5 su\'cat quy \'ae\'denh t\'b9i \'a7i\'d2u 1 Ngh\'de 
\'ae\'denh s\'e8 94/1998/N\'a7-CP ng\'b5y 17/11/1998 c\'f1a Ch\'ddnh ph\'f1.
\par Ngo\'b5i thu\'d5 su\'cat th\'abng th\'ad\'eang, thu\'d5 su\'cat \'adu \'ae\'b7i v\'b5 thu\'d5 su\'cat \'adu \'ae\'b7i \'ae\'c6c bi\'d6t, h\'b5ng h\'e3a nh\'cbp kh\'c8u trong m\'e9t s\'e8 tr\'ad\'eang h\'eep c\'dfn b\'de \'ae\'b8nh thu\'d5 su\'cat b\'e6
 sung v\'b5 s\'cf c\'e3 h\'ad\'edng d\'c9n ri\'aang.
\par 2/ Thu\'d5 su\'cat thu\'d5 xu\'cat kh\'c8u:
\par Thu\'d5 su\'cat thu\'d5 xu\'cat kh\'c8u c\'f1a t\'f5ng m\'c6t h\'b5ng th\'f9c hi\'d6n theo Bi\'d3u thu\'d5 thu\'d5 xu\'cat kh\'c8u.
\par  
\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28 c - \'a7\'a8ng k\'fd, k\'aa khai h\'b5ng h\'e3a xu\'cat kh\'c8u, \line  nh\'cbp kh\'c8u v\'b5 n\'e9p thu\'d5
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 I/ K\'aa khai H\'b6i quan h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par 1/ T\'e6 ch\'f8c, c\'b8 nh\'a9n m\'e7i l\'c7n c\'e3 h\'b5ng h\'e3a \'ae\'ad\'eec ph\'d0p xu\'cat kh\'c8u ph\'b6i k\'aa khai \'ae\'c7y \'ae\'f1, ch\'ddnh x\'b8c c\'b8c n\'e9i dung theo quy \'ae\'denh c\'f1a c\'ac quan H\'b6i quan, n\'e9p t\'ea khai h\'b5
ng h\'e3a xu\'cat kh\'c8u, v\'b5 n\'e9p thu\'d5 xu\'cat kh\'c8u cho c\'ac quan H\'b6i quan n\'aci l\'b5m th\'f1 t\'f4c xu\'cat kh\'c8u.
\par 2/ T\'e6 ch\'f8c, c\'b8 nh\'a9n m\'e7i l\'c7n c\'e3 h\'b5ng h\'e3a \'ae\'ad\'eec ph\'d0p nh\'cbp kh\'c8u ph\'b6i k\'aa khai \'ae\'c7y \'ae\'f1, ch\'ddnh x\'b8c c\'b8c n\'e9i dung theo quy \'ae\'denh c\'f1a c\'ac quan H\'b6i quan, n\'e9p t\'ea khai h\'b5
ng h\'e3a nh\'cbp kh\'c8u v\'b5 n\'e9p thu\'d5 nh\'cbp kh\'c8u cho c\'ac quan H\'b6i quan n\'aci c\'e3 c\'f6a kh\'c8u nh\'cbp kh\'c8u h\'b5ng h\'e3a.
\par Tr\'ad\'eang h\'eep h\'b5ng h\'e3a nh\'cbp kh\'c8u \'ae\'ad\'eec ph\'d0p l\'b5m th\'f1 t\'f4c th\'abng qua t\'b9i c\'b8c \'ae\'dea \'aei\'d3m ngo\'b5i c\'f6a kh\'c8u nh\'cbp kh\'c8u, th\'d7 tr\'d7nh t\'f9 k\'aa khai t\'ddnh thu\'d5 \'ae\'ad\'eec th\'f9
c hi\'d6n nh\'ad sau: C\'ac quan H\'b6i quan t\'b9i \'ae\'dea \'aei\'d3m th\'abng quan c\'e3 tr\'b8ch nhi\'d6m ti\'d5p nh\'cbn t\'ea khai h\'b5ng nh\'cbp kh\'c8u v\'b5 to\'b5n b\'e9 h\'e5 s\'ac c\'e3 li\'aan quan \'ae\'d5n l\'ab h\'b5ng nh\'cbp kh\'c8u 
\'ae\'d3 l\'b5m th\'f1 t\'f4c nh\'cbp kh\'c8u, sau \'ae\'e3 chuy\'d3n cho c\'ac quan H\'b6i quan c\'e3 c\'f6a kh\'c8u nh\'cbp kh\'c8u. C\'ac quan H\'b6i quan c\'e3 c\'f6a kh\'c8u nh\'cbp kh\'c8u c\'e3 tr\'b8ch nhi\'d6m ki\'d3m tra l\'b9i to\'b5n b\'e9 h
\'e5 s\'ac nh\'cbp kh\'c8u c\'f1a l\'ab h\'b5ng \'ae\'d3 \'ae\'e8i chi\'d5u v\'edi c\'b8c ch\'f8ng t\'f5 c\'e3 li\'aan quan \'ae\'d5n vi\'d6c nh\'cbp kh\'c8u (t\'b9i c\'b6ng, h\'b7ng t\'c7u...) v\'b5 quy\'d5t \'ae\'denh vi\'d6c cho ph\'d0p chuy\'d3n l\'ab
 h\'b5ng v\'d2 n\'aci l\'b5m th\'f1 t\'f4c th\'abng quan ngo\'b5i c\'f6a kh\'c8u. Sau khi ki\'d3m h\'e3a, t\'ddnh thu\'d5 c\'ac quan H\'b6i quan n\'aci l\'b5m th\'f1 t\'f4c th\'abng quan ngo\'b5i c\'f6a kh\'c8u ph\'b6i c\'e3 tr\'b8ch nhi\'d6m b\'b5
n giao m\'e9t b\'e9 h\'e5 s\'ac H\'b6i quan h\'b5ng nh\'cbp kh\'c8u (k\'ccm theo th\'abng b\'b8o thu\'d5 ph\'b6i n\'e9p) cho c\'ac quan H\'b6i quan c\'f6a kh\'c8u h\'b5ng nh\'cbp \'ae\'d3 l\'adu theo d\'e2i. H\'b5ng h\'e3a v\'cbn chuy\'d3n t\'f5 c\'f6a kh
\'c8u nh\'cbp kh\'c8u \'ae\'d5n n\'aci l\'b5m th\'f1 t\'f4c th\'abng quan ngo\'b5i c\'f6a kh\'c8u ph\'b6i ch\'deu s\'f9 gi\'b8m s\'b8t, qu\'b6n l\'fd theo quy \'ae\'denh c\'f1a c\'ac quan H\'b6i quan.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 II/ Th\'eai \'aei\'d3m t\'ddnh thu\'d5 v\'b5 th\'eai h\'b9n th\'abng b\'b8o thu\'d5:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par 1/ Th\'eai \'aei\'d3m t\'ddnh thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u l\'b5 ng\'b5y \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 \'ae\'b7 n\'e9p t\'ea khai h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u cho c\'ac quan H\'b6i quan.
\par Thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u \'ae\'ad\'eec t\'ddnh theo thu\'d5 su\'cat, gi\'b8 t\'ddnh thu\'d5, t\'fb gi\'b8 t\'b9i ng\'b5y \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 n\'e9p t\'ea khai h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u cho c
