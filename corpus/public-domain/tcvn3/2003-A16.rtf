\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28  a - ph\'b9m vi \'b8p d\'f4ng}{
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 I/ \'a7\'e8i t\'ad\'eeng ch\'deu thu\'d5, \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5:}{
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par 1/ \'a7\'e8i t\'ad\'eeng ch\'deu thu\'d5:
\par H\'b5ng h\'e3a \'ae\'ad\'eec ph\'d0p xu\'cat kh\'c8u, nh\'cbp kh\'c8u qua c\'f6a kh\'c8u, bi\'aan gi\'edi Vi\'d6t Nam quy \'ae\'denh t\'b9i \'a7i\'d2u 1 Ngh\'de \'ae\'denh s\'e8 54/CP ng\'b5y 28/08/1993 c\'f1a Ch\'ddnh ph\'f1 \'ae\'d2u l\'b5 \'ae\'e8i t
\'ad\'eeng ch\'deu thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u. Tr\'f5 nh\'f7ng tr\'ad\'eang h\'eep ghi \'eb m\'f4c II Ph\'c7n A Th\'abng t\'ad n\'b5y.
\par 2/ \'a7\'e8i t\'ad\'eeng n\'e9p thu\'d5:
\par T\'e6 ch\'f8c, c\'b8 nh\'a9n c\'e3 h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u thu\'e9c \'ae\'e8i t\'ad\'eeng ch\'deu thu\'d5 quy \'ae\'denh t\'b9i \'a7i\'d3m 1, M\'f4c I, Ph\'c7n A Th\'abng t\'ad n\'b5y \'ae\'d2u l\'b5 \'ae\'e8i t\'ad\'eeng n\'e9
p thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 II/ \'a7\'e8i t\'ad\'eeng kh\'abng ch\'deu thu\'d5 xu\'cat kh\'c8u, nh\'cbp kh\'c8u:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par H\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u kh\'abng thu\'e9c di\'d6n ch\'deu thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u sau khi l\'b5m th\'f1 t\'f4c H\'b6i quan, theo \'a7i\'d2u 3 c\'f1a Ngh\'de \'ae\'denh s\'e8 54/CP ng\'b5y 28/08/1993 g\'e5m:

\par 1/ H\'b5ng qu\'b8 c\'b6nh v\'b5 m\'ad\'een \'ae\'ad\'eang qua l\'b7nh th\'e6 Vi\'d6t Nam.
\par 2/ H\'b5ng kinh doanh theo ph\'ad\'acng th\'f8c chuy\'d3n kh\'cau, bao g\'e5m c\'b8c h\'d7nh th\'f8c: 
\par - H\'b5ng h\'e3a \'ae\'ad\'eec v\'cbn chuy\'d3n th\'bcng t\'f5 n\'ad\'edc xu\'cat kh\'c8u \'ae\'d5n n\'ad\'edc nh\'cbp kh\'c8u kh\'abng qua c\'f6a kh\'c8u Vi\'d6t Nam.
\par - H\'b5ng h\'e3a \'ae\'ad\'eec v\'cbn chuy\'d3n t\'f5 n\'ad\'edc xu\'cat kh\'c8u \'ae\'d5n n\'ad\'edc nh\'cbp kh\'c8u c\'e3 qua c\'f6a kh\'c8u Vi\'d6t Nam nh\'adng kh\'abng l\'b5m th\'f1 t\'f4c nh\'cbp kh\'c8u v\'b5o Vi\'d6t Nam v\'b5 kh\'abng l\'b5m th
\'f1 t\'f4c xu\'cat kh\'c8u ra kh\'e1i Vi\'d6t Nam.
\par - H\'b5ng h\'e3a \'ae\'ad\'eec v\'cbn chuy\'d3n t\'f5 n\'ad\'edc xu\'cat kh\'c8u \'ae\'d5n n\'ad\'edc nh\'cbp kh\'c8u c\'e3 qua c\'f6a kh\'c8u Vi\'d6t Nam v\'b5 \'ae\'ada v\'b5o kho ngo\'b9i quan, kh\'abng l\'b5m th\'f1 t\'f4c nh\'cbp kh\'c8u v\'b5o Vi
\'d6t Nam v\'b5 kh\'abng l\'b5m th\'f1 t\'f4c xu\'cat kh\'c8u ra kh\'e1i Vi\'d6t Nam.
\par Trong qu\'b8 tr\'d7nh v\'cbn chuy\'d3n, l\'adu kho tr\'aan l\'b7nh th\'e6 Vi\'d6t Nam h\'b5ng h\'e3a qu\'b8 c\'b6nh, m\'ad\'een \'ae\'ad\'eang, chuy\'d3n kh\'c8u ph\'b6i ch\'deu s\'f9 gi\'b8m s\'b8t v\'b5 qu\'b6n l\'fd theo quy \'ae\'denh c\'f1a c\'ac
 quan H\'b6i quan t\'f5 khi nh\'cbp kh\'c8u \'ae\'d5n khi xu\'cat kh\'c8u, kh\'abng \'ae\'ad\'eec ti\'aau th\'f4 t\'b9i th\'de tr\'ad\'eang Vi\'d6t Nam. Tr\'ad\'eang h\'eep \'ae\'c6c bi\'d6t, h\'b5ng h\'e3a ti\'aau th\'f4 t\'b9i Vi\'d6t Nam ph\'b6i \'ae
\'ad\'eec ph\'d0p c\'f1a c\'ac quan qu\'b6n l\'fd Nh\'b5 n\'ad\'edc c\'e3 th\'c8m quy\'d2n c\'f1a Vi\'d6t Nam v\'b5 ph\'b6i l\'b5m \'ae\'c7y \'ae\'f1 th\'f1 t\'f4c H\'b6i quan.
\par 3/ H\'b5ng h\'e3a t\'f5 n\'ad\'edc ngo\'b5i nh\'cbp kh\'c8u v\'b5o khu ch\'d5 xu\'cat, doanh nghi\'d6p ch\'d5 xu\'cat v\'b5 h\'b5ng h\'e3a t\'f5 khu ch\'d5 xu\'cat, doanh nghi\'d6p ch\'d5 xu\'cat xu\'cat kh\'c8u ra n\'ad\'edc ngo\'b5i (tr\'f9c ti\'d5p ho
\'c6c qua c\'b8c c\'f6a kh\'c8u Vi\'d6t Nam) ho\'c6c h\'b5ng h\'e3a \'ae\'ada t\'f5 khu ch\'d5 xu\'cat, doanh nghi\'d6p ch\'d5 xu\'cat n\'b5y sang khu ch\'d5 xu\'cat, doanh nghi\'d6p ch\'d5 xu\'cat kh\'b8c trong l\'b7nh th\'e6 Vi\'d6t Nam.
\par 4/ H\'b5ng vi\'d6n tr\'ee nh\'a9n \'ae\'b9o.
\par H\'e5 s\'ac c\'c7n thi\'d5t khi l\'b5m th\'f1 t\'f4c H\'b6i quan \'ae\'e8i v\'edi c\'b8c tr\'ad\'eang h\'eep ghi t\'b9i M\'f4c n\'b5y theo quy \'ae\'denh c\'f1a T\'e6ng c\'f4c H\'b6i quan.
\par 
\par }\pard \qc\sb120\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs22\expnd5\expndtw28 b - c\'a8n c\'f8 t\'ddnh thu\'d5
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par C\'a8n c\'f8 \'ae\'d3 t\'ddnh thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u l\'b5 s\'e8 l\'ad\'eeng h\'b5ng h\'e3a, gi\'b8 t\'ddnh thu\'d5 v\'b5 thu\'d5 su\'cat c\'f1a m\'c6t h\'b5ng xu\'cat kh\'c8u, nh\'cbp kh\'c8u.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 I/ S\'e8 l\'ad\'eeng h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par S\'e8 l\'ad\'eeng h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u l\'b5m c\'a8n c\'f8 t\'ddnh thu\'d5 l\'b5 s\'e8 l\'ad\'eeng t\'f5ng m\'c6t h\'b5ng th\'f9c t\'d5 xu\'cat kh\'c8u, nh\'cbp kh\'c8u.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 II/ Gi\'b8 t\'ddnh thu\'d5:}{
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par 1/ Tr\'ad\'eang h\'eep \'b8p gi\'b8 t\'ddnh thu\'d5 theo H\'eep \'ae\'e5ng: H\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u theo h\'eep \'ae\'e5ng mua b\'b8n ngo\'b9i th\'ad\'acng, c\'e3 \'ae\'f1 n\'e9i dung ch\'f1 y\'d5u theo quy \'ae\'denh t\'b9i \'a7i
\'d2u 50 Lu\'cbt Th\'ad\'acng m\'b9i ng\'b5y 10/05/1997 (tr\'f5 c\'b8c m\'c6t h\'b5ng thu\'e9c danh m\'f4c m\'c6t h\'b5ng Nh\'b5 n\'ad\'edc qu\'b6n l\'fd gi\'b8 t\'ddnh thu\'d5) th\'d7 gi\'b8 t\'ddnh thu\'d5 \'ae\'ad\'eec x\'b8c \'ae\'denh theo h\'eep 
\'ae\'e5ng ngo\'b9i th\'ad\'acng ph\'ef h\'eep v\'edi c\'b8c ch\'f8ng t\'f5 c\'e3 li\'aan quan \'ae\'d5n vi\'d6c mua, b\'b8n. C\'f4 th\'d3:
\par a/ \'a7\'e8i v\'edi h\'b5ng xu\'cat kh\'c8u l\'b5 gi\'b8 b\'b8n cho kh\'b8ch h\'b5ng t\'b9i c\'f6a kh\'c8u xu\'cat (gi\'b8 FOB), kh\'abng bao g\'e5m ph\'dd b\'b6o hi\'d3m (I) v\'b5 chi ph\'dd v\'cbn t\'b6i (F).
\par b/ \'a7\'e8i v\'edi h\'b5ng nh\'cbp kh\'c8u l\'b5 gi\'b8 mua t\'b9i c\'f6a kh\'c8u nh\'cbp (CIF) bao g\'e5m c\'b6 ph\'dd b\'b6o hi\'d3m (I) v\'b5 chi ph\'dd v\'cbn t\'b6i (F). N\'d5u nh\'cbp kh\'c8u b\'bbng \'ae\'ad\'eang b\'e9 l\'b5 gi\'b8 mua theo \'aei
\'d2u ki\'d6n bi\'aan gi\'edi Vi\'d6t Nam (DAF).
\par 
\par c/ Gi\'b8 t\'ddnh thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u \'b8p d\'f4ng \'ae\'e8i v\'edi khu ch\'d5 xu\'cat, doanh nghi\'d6p ch\'d5 xu\'cat t\'b9i Vi\'d6t Nam l\'b5 gi\'b8 th\'f9c t\'d5 mua, b\'b8n t\'b9i c\'f6a kh\'c8u khu ch\'d5 xu\'ca
t, doanh nghi\'d6p ch\'d5 xu\'cat theo h\'eep \'ae\'e5ng.
\par d/ \'a7\'e8i v\'edi tr\'ad\'eang h\'eep h\'b5ng nh\'cbp kh\'c8u, c\'e3 bao g\'e5m h\'b5ng b\'b6o h\'b5nh theo h\'eep \'ae\'e5ng (k\'d3 c\'b6 tr\'ad\'eang h\'eep g\'f6i h\'b5ng sau) nh\'adng trong h\'eep \'ae\'e5ng kh\'abng t\'ddnh thanh to\'b8n ri\'aang 
\'ae\'e8i v\'edi s\'e8 h\'b5ng h\'e3a b\'b6o h\'b5nh th\'d7 gi\'b8 t\'ddnh thu\'d5 tr\'aan h\'eep \'ae\'e5ng l\'b5 gi\'b8 bao g\'e5m c\'b6 ph\'c7n b\'b6o h\'b5nh.
\par e/ \'a7\'e8i v\'edi m\'b8y m\'e3c, thi\'d5t b\'de, ph\'ad\'acng ti\'d6n v\'cbn t\'b6i \'ae\'ada ra n\'ad\'edc ngo\'b5i \'ae\'d3 s\'f6a ch\'f7a, th\'d7 gi\'b8 t\'ddnh thu\'d5 khi nh\'cbp kh\'c8u tr\'eb l\'b9i Vi\'d6t Nam l\'b5 chi ph\'dd s\'f6a ch\'f7
a theo h\'eep \'ae\'e5ng \'ae\'b7 k\'fd v\'edi n\'ad\'edc ngo\'b5i.
\par g/ \'a7\'e8i v\'edi m\'b8y m\'e3c, thi\'d5t b\'de, ph\'ad\'acng ti\'d6n v\'cbn t\'b6i \'aei thu\'aa th\'d7 gi\'b8 t\'ddnh thu\'d5 l\'b5 gi\'b8 thu\'aa theo h\'eep \'ae\'e5ng \'ae\'b7 k\'fd v\'edi n\'ad\'edc ngo\'b5i.
\par h/ \'a7\'e8i v\'edi h\'b5ng h\'e3a do ph\'dda n\'ad\'edc ngo\'b5i gia c\'abng cho ph\'dda Vi\'d6t Nam, th\'d7 gi\'b8 t\'ddnh thu\'d5 khi nh\'cbp kh\'c8u l\'b5 gi\'b8 tr\'de th\'f9c t\'d5 c\'f1a h\'b5ng h\'e3a nh\'cbp kh\'c8u tr\'f5 \'aei gi\'b8 tr\'de c
\'f1a nguy\'aan li\'d6u, v\'cbt t\'ad, h\'b5ng h\'e3a xu\'cat ra n\'ad\'edc ngo\'b5i \'ae\'d3 gia c\'abng, theo h\'eep \'ae\'e5ng \'ae\'b7 k\'fd (thu\'d5 su\'cat thu\'d5 nh\'cbp kh\'c8u t\'ddnh theo m\'c6t h\'b5ng gia c\'abng th\'f9c t\'d5 nh\'cbp kh\'c8
u v\'b5 xu\'cat x\'f8 c\'f1a h\'b5ng h\'e3a l\'b5 xu\'cat x\'f8 c\'f1a n\'ad\'edc nh\'cbn gia c\'abng, gi\'b8 tr\'de th\'f9c t\'d5 h\'b5ng nh\'cbp kh\'c8u \'ae\'ad\'eec x\'b8c \'ae\'denh theo gi\'b8 t\'ddnh thu\'d5 quy \'ae\'denh t\'b9i M\'f4c II, Ph\'c7
n B Th\'abng t\'ad n\'b5y).
\par i/ \'a7\'e8i v\'edi h\'b5ng h\'e3a nh\'cbp kh\'c8u \'ae\'b7 \'ae\'ada v\'b5o s\'f6 d\'f4ng t\'b9i Vi\'d6t Nam ph\'b6i truy thu, th\'d7 gi\'b8 t\'ddnh thu\'d5 truy thu \'ae\'ad\'eec x\'b8c \'ae\'denh tr\'aan c\'ac s\'eb gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l
\'b9i c\'f1a h\'b5ng h\'e3a t\'b9i th\'eai \'aei\'d3m t\'ddnh truy thu thu\'d5, theo k\'d5t qu\'b6 gi\'b8m \'ae\'denh ch\'cat l\'ad\'eeng h\'b5ng h\'e3a c\'f1a c\'ac quan Nh\'b5 n\'ad\'edc c\'e3 th\'c8m quy\'d2n v\'b5 \'ae\'ad\'eec t\'ddnh c\'f4 th\'d3 nh
\'ad sau:
\par - Gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l\'b9i t\'f5 30% tr\'eb xu\'e8ng, th\'d7 gi\'b8 t\'ddnh thu\'d5 b\'bbng 10% c\'f1a gi\'b8 nh\'cbp kh\'c8u h\'b5ng m\'edi.
\par - Gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l\'b9i tr\'aan 30% \'ae\'d5n 50%, th\'d7 gi\'b8 t\'ddnh thu\'d5 b\'bbng 20% c\'f1a gi\'b8 nh\'cbp kh\'c8u h\'b5ng m\'edi.
\par - Gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l\'b9i tr\'aan 50% \'ae\'d5n 70%, th\'d7 gi\'b8 t\'ddnh thu\'d5 b\'bbng 30% c\'f1a gi\'b8 nh\'cbp kh\'c8u h\'b5ng m\'edi.
\par - Gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l\'b9i tr\'aan 70% \'ae\'d5n 85%, th\'d7 gi\'b8 t\'ddnh thu\'d5 b\'bbng 45% c\'f1a gi\'b8 nh\'cbp kh\'c8u h\'b5ng m\'edi.
\par - Gi\'b8 tr\'de s\'f6 d\'f4ng c\'dfn l\'b9i tr\'aan 85%, th\'d7 gi\'b8 t\'ddnh thu\'d5 b\'bbng 60% c\'f1a gi\'b8 nh\'cbp kh\'c8u h\'b5ng m\'edi.
\par 2/ \'a7\'e8i v\'edi m\'e9t s\'e8 m\'c6t h\'b5ng Nh\'b5 n\'ad\'edc qu\'b6n l\'fd gi\'b8 th\'d7 gi\'b8 t\'ddnh thu\'d5 l\'b5 gi\'b8 theo B\'b6ng gi\'b8 c\'f1a B\'e9 T\'b5i ch\'ddnh quy \'ae\'denh. Tr\'ad\'eang h\'eep gi\'b8 tr\'aan h\'eep \'ae\'e5ng mua, b
\'b8n ngo\'b9i th\'ad\'acng cao h\'acn gi\'b8 quy \'ae\'denh t\'b9i B\'b6ng gi\'b8 c\'f1a B\'e9 T\'b5i ch\'ddnh th\'d7 t\'ddnh theo gi\'b8 h\'eep \'ae\'e5ng.
\par 3/ \'a7\'e8i v\'edi h\'b5ng h\'e3a nh\'cbp kh\'c8u kh\'abng \'ae\'f1 \'aei\'d2u ki\'d6n \'ae\'d3 x\'b8c \'ae\'denh gi\'b8 t\'ddnh thu\'d5 theo h\'eep \'ae\'e5ng quy \'ae\'denh t\'b9i Th\'abng t\'ad s\'e8 82/1997/TT/BTC ng\'b5y11/11/1997 c\'f1a B\'e9 T\'b5
i ch\'ddnh, ho\'c6c \'ae\'e8i v\'edi h\'b5ng h\'e3a nh\'cbp kh\'c8u theo c\'b8c ph\'ad\'acng th\'f8c kh\'b8c kh\'abng th\'abng qua h\'eep \'ae\'e5ng mua, b\'b8n (nh\'ad h\'b5ng bi\'d5u, t\'c6ng, xu\'cat nh\'cbp kh\'c8u phi m\'cbu d\'dech, ho\'b9t \'ae\'e9
ng xu\'a9t nh\'cbp kh\'c8u c\'f1a c\'ad d\'a9n bi\'aan gi\'edi...); kh\'abng thanh to\'b8n qua Ng\'a9n h\'b5ng (nh\'ad h\'b5ng \'ae\'e6i h\'b5ng, h\'b5ng tr\'b6 c\'abng...) th\'d7 gi\'b8 t\'ddnh thu\'d5 \'ae\'ad\'eec th\'f9c hi\'d6n theo B\'b6ng gi\'b8 t
\'ddnh thu\'d5 c\'f1a B\'e9 T\'b5i ch\'ddnh quy \'ae\'denh (\'ae\'e8i v\'edi c\'b8c m\'c6t h\'b5ng Nh\'b5 n\'ad\'edc qu\'b6n l\'fd gi\'b8) ho\'c6c c\'f1a T\'e6ng c\'f4c H\'b6i quan quy \'ae\'denh (\'ae\'e8i v\'edi c\'b8c m\'c6t h\'b5ng Nh\'b5 n\'ad\'ed
c kh\'abng qu\'b6n l\'fd gi\'b8).
\par \'a7i\'d2u ki\'d6n th\'f9c hi\'d6n \'b8p d\'f4ng gi\'b8 t\'ddnh thu\'d5 nh\'cbp kh\'c8u theo h\'eep \'ae\'e5ng ngo\'b9i th\'ad\'acng \'ae\'ad\'eec th\'f9c hi\'d6n theo Th\'abng t\'ad s\'e8 82/1997/TT/BTC ng\'b5y 11/11/1997 c\'f1a B\'e9 T\'b5i ch\'ddnh.

\par 4/ T\'fb gi\'b8 t\'ddnh thu\'d5:
\par Gi\'b8 t\'ddnh thu\'d5 \'ae\'ad\'eec t\'ddnh b\'bbng \'ae\'e5ng Vi\'d6t Nam. T\'fb gi\'b8 l\'b5m c\'ac s\'eb \'ae\'d3 x\'b8c \'ae\'denh gi\'b8 t\'ddnh thu\'d5 \'ae\'e8i v\'edi h\'b5ng h\'e3a xu\'cat kh\'c8u, nh\'cbp kh\'c8u l\'b5 t\'fb gi\'b8 mua, b\'b8
n th\'f9c t\'d5 b\'d7nh qu\'a9n tr\'aan th\'de tr\'ad\'eang ngo\'b9i t\'d6 li\'aan Ng\'a9n h\'b5ng do Ng\'a9n h\'b5ng Nh\'b5 n\'ad\'edc Vi\'d6t Nam c\'abng b\'e8 \'ae\'ad\'eec \'ae\'a8ng tr\'aan b\'b8o Nh\'a9n d\'a9n h\'b5ng ng\'b5y. Tr\'ad\'eang h\'eep v
\'b5o c\'b8c ng\'b5y kh\'abng ph\'b8t h\'b5nh b\'b8o Nh\'a9n d\'a9n h\'b5ng ng\'b5y (ho\'c6c c\'e3 ph\'b8t h\'b5nh nh\'adng kh\'abng th\'abng b\'b8o t\'fb gi\'b8) th\'d7 t\'fb gi\'b8 t\'ddnh thu\'d5 c\'f1a ng\'b5y h\'abm \'ae\'e3 \'ae\'ad\'eec \'b8p d\'f4
ng theo t\'fb gi\'b8 t\'ddnh thu\'d5 c\'f1a ng\'b5y tr\'ad\'edc \'ae\'e3.
\par \'a7\'e8i v\'edi c\'b8c \'ae\'e5ng ngo\'b9i t\'d6 kh\'abng c\'e3 giao d\'dech tr\'aan th\'de tr\'ad\'eang ngo\'b9i t\'d6 li\'aan Ng\'a9n h\'b5ng th\'d7 x\'b8c \'ae\'denh theo nguy\'aan t\'bec t\'fb gi\'b8 t\'ddnh ch\'d0o gi\'f7a t\'fb gi\'b8 \'ae\'e5ng 
\'ae\'ab la M\'fc (USD) v\'edi \'ae\'e5ng Vi\'d6t Nam mua, b\'b8n th\'f9c t\'d5 b\'d7nh qu\'a9n tr\'aan th\'de tr\'ad\'eang li\'aan Ng\'a9n h\'b5ng v\'b5 t\'fb gi\'b8 gi\'f7a \'ae\'e5ng \'ae\'ab la M\'fc v\'edi c\'b8c ngo\'b9i t\'d6 kh\'b8c tr\'aan th\'de
 tr\'ad\'eang Qu\'e8c t\'d5 do Ng\'a9n h\'b5ng Nh\'b5 n\'ad\'edc Vi\'d6t Nam c\'abng b\'e8.
\par 5/ Thu\'d5 xu\'cat kh\'c8u, thu\'d5 nh\'cbp kh\'c8u \'ae\'ad\'eec n\'e9p b\'bbng \'ae\'e5ng Vi\'d6t Nam. Tr\'ad\'eang h\'eep \'ae\'e8i t\'ad\'eeng n\'e9p thu\'d5 mu\'e8n n\'e9p thu\'d5 b\'bbng ngo\'b9i t\'d6 th\'d7 ph\'b6i n\'e9p b\'bbng ngo\'b9i t\'d6 t
\'f9 do chuy\'d3n \'ae\'e6i do Ng\'a9n h\'b5ng Nh\'b5 n\'ad\'edc Vi\'d6t Nam c\'abng b\'e8.
\par Nh\'f7ng tr\'ad\'eang h\'eep ph\'b6i n\'e9p thu\'d5 b\'bbng ngo\'b9i t\'d6 do B\'e9 T\'b5i ch\'ddnh quy\'d5t \'ae\'denh \'ae\'e8i v\'edi t\'f5ng tr\'ad\'eang h\'eep.
\par 
\par }\pard \qc\sa120\keepn\nowidctlpar\widctlpar\adjustright {\b\f16\fs20\expnd4\expndtw24 III/ Thu\'d5 su\'cat:
\par }\pard \qj\fi567\sa120\nowidctlpar\widctlpar\adjustright {
\par Thu\'d5 su\'cat thu\'d5 nh\'cbp kh\'c8u:
\par Thu\'d5 su\'cat \'ae\'e8i v\'edi h\'b5ng nh\'cbp kh\'c8u g\'e5m thu\'d5 su\'cat th\'abng th\'ad\'eang, thu\'d5 su\'cat \'adu \'ae\'b7i v\'b5 thu\'d5 su\'cat \'adu \'ae\'b7i \'ae\'c6c bi\'d6t \'ae\'ad\'eec th\'f9c hi\'d6n nh\'ad sau:
\par a/ Thu\'d5 su\'cat \'adu \'ae\'b7i l\'b5 thu\'d5 su\'cat ch\'d8 \'b8p d\'f4ng cho h\'b5ng h\'e3a nh\'cbp kh\'c8u c\'e3 xu\'cat x\'f8 t\'f5 n\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc c\'e3 th\'e1a thu\'cbn v\'d2 \'ae\'e8i x\'f6 t\'e8i h\'f4\'aa qu\'e8
c trong quan h\'d6 Th\'ad\'acng m\'b9i v\'edi Vi\'d6t Nam \'ae\'ad\'eec quy \'ae\'denh c\'f4 th\'d3 cho t\'f5ng m\'c6t h\'b5ng trong Bi\'d3u thu\'d5 thu\'d5 nh\'cbp kh\'c8u \'adu \'ae\'b7i.
\par \'a7i\'d2u ki\'d6n \'ae\'d3 \'ae\'ad\'eec \'b8p d\'f4ng thu\'d5 su\'cat \'adu \'ae\'b7i:
\par - H\'b5ng h\'e3a nh\'cbp kh\'c8u c\'e3 gi\'cay ch\'f8ng nh\'cbn xu\'cat x\'f8 (C/O) t\'f5 n\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc \'ae\'b7 c\'e3 th\'e1a thu\'cbn v\'d2 \'ae\'e8i x\'f6 t\'e8i h\'f4\'aa qu\'e8c trong quan h\'d6 Th\'ad\'acng m\'b9i v\'edi Vi
\'d6t Nam. N\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc \'ae\'e3 ph\'b6i n\'bbm trong danh s\'b8ch c\'b8c n\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc do B\'e9 Th\'ad\'acng m\'b9i th\'abng b\'b8o \'ae\'b7 c\'e3 th\'e1a thu\'cbn v\'d2 \'ae\'e8i x\'f6 t\'e8i h\'f4\'aa qu
\'e8c trong quan h\'d6 Th\'ad\'acng m\'b9i v\'edi Vi\'d6t Nam;
\par - Gi\'cay ch\'f8ng nh\'cbn xu\'cat x\'f8 h\'b5ng h\'e3a (C/O) ph\'b6i ph\'ef h\'eep v\'edi quy \'ae\'denh c\'f1a B\'e9 Th\'ad\'acng m\'b9i.
\par b/ Thu\'d5 su\'cat \'adu \'ae\'b7i \'ae\'c6c bi\'d6t l\'b5 thu\'d5 su\'cat \'ae\'ad\'eec \'b8p d\'f4ng cho h\'b5ng h\'e3a nh\'cbp kh\'c8u c\'e3 xu\'cat x\'f8 t\'f5 n\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc m\'b5 Vi\'d6t Nam v\'b5 n\'ad\'edc ho\'c6c kh\'e8i n
\'ad\'edc \'ae\'e3 \'ae\'b7 th\'e1a thu\'cbn \'adu \'ae\'b7i \'ae\'c6c bi\'d6t v\'d2 thu\'d5 nh\'cbp kh\'c8u theo th\'d3 ch\'d5 khu v\'f9c th\'ad\'acng m\'b9i t\'f9 do, li\'aan minh quan thu\'d5 ho\'c6c \'ae\'d3 t\'b9o thu\'cbn l\'eei cho giao l\'adu th
\'ad\'acng m\'b9i bi\'aan gi\'edi v\'b5 tr\'ad\'eang h\'eep \'adu \'ae\'b7i \'ae\'c6c bi\'d6t kh\'b8c. Thu\'d5 su\'cat \'adu \'ae\'b7i \'ae\'c6c bi\'d6t \'ae\'ad\'eec \'b8p d\'f4ng c\'f4 th\'d3 cho t\'f5ng m\'c6t h\'b5ng theo quy \'ae\'denh trong th\'e1
a thu\'cbn.
\par \'a7i\'d2u ki\'d6n \'ae\'d3 \'ae\'ad\'eec \'b8p d\'f4ng thu\'d5 su\'cat \'adu \'ae\'b7i \'ae\'c6c bi\'d6t:
\par - H\'b5ng nh\'cbp kh\'c8u c\'e3 gi\'cay ch\'f8ng nh\'cbn xu\'cat x\'f8 (C/O) t\'f5 n\'ad\'edc ho\'c6c kh\'e8i n\'ad\'edc \'ae\'b7 c\'e3 th\'e1a thu\'cbn \'adu \'ae\'b7i \'ae\'c6c bi\'d6t v\'d2 thu\'d5 nh\'cbp kh\'c8u \'ae\'e8i v\'edi Vi\'d6t Nam. Gi\'ca
y ch\'f8ng nh\'cbn xu\'cat x\'f8 h\'b5ng h\'e3a (C/O) ph\'b6i ph\'ef h\'eep v\'edi quy \'ae\'denh c\'f1a B\'e9 Th\'ad\'acng m\'b9i;
\par - H\'b5ng nh\'cbp kh\'c8u ph\'b6i l\'b5 nh\'f7ng m\'c6t h\'b5ng \'ae\'ad\'eec quy \'ae\'denh c\'f4 th\'d3 trong th\'e1a thu\'cbn v\'b5 ph\'b6i \'ae\'b8p \'f8ng \'ae\'f1 c\'b8c \'aei\'d2u ki\'d6n \'ae\'b7 ghi trong th\'e1a thu\'cbn.
\par c/ Thu\'d5 su\'cat th\'abng th\'ad\'eang l\'b5 thu\'d5 su\'cat \'ae\'ad\'eec \'b8p d\'f4ng cho h\'b5ng h\'e3a nh\'cbp kh\'c8u c\'e3 xu\'cat x\'f8 t\'f5 n\'ad\'edc kh\'abng c\'e3 th\'e1a thu\'cbn v\'d2 \'ae\'e8i x\'f6 t\'e8i h\'f4\'aa qu\'e8c trong quan h
\'d6 Th\'ad\'acng m\'b9i v\'edi Vi\'d6t Nam.
\par Thu\'d5 su\'cat th\'abng th\'ad\'eang cao h\'acn 50% (n\'a8m m\'ad\'aci ph\'c7n tr\'a8m) so v\'edi thu\'d5 su\'cat \'adu \'ae\'b7i c\'f1a t\'f5ng m\'c6t h\'b5ng quy \'ae\'denh t\'b9i Bi\'d3u thu\'d5 thu\'d5 nh\'cbp kh\'c8u \'adu \'ae\'b7i v\'b5 \'ae\'ad
\'eec t\'ddnh nh\'ad sau:
